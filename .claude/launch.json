{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-p", "rainalator", "up", "db"],
      "port": 5432,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": ["quarkusDev", "--console=plain"],
      "cwd": "backend",
      "port": 8080
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "frontend",
      "port": 4200
    }
  ]
}
